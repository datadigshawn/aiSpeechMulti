# ============================================================
# aiSpeech 環境變數設定範例
# 使用方式：複製此檔案為 .env 並填入實際值
# 注意：.env 已加入 .gitignore，不會被 commit
# ============================================================

# ------------------------------------------------------------
# Google Cloud Speech-to-Text (STT) 認證
# ------------------------------------------------------------
# 服務帳戶金鑰 JSON 檔案路徑
# 程式會自動搜尋以下位置（按優先順序）：
#   1. 此環境變數指定的路徑
#   2. utils/google-speech-key.json
#   3. config/google-speech-key.json
#   4. google-speech-key.json（根目錄）
GOOGLE_APPLICATION_CREDENTIALS=./utils/google-speech-key.json

# Google Cloud 專案 ID
# 通常由程式自動從 google-speech-key.json 的 project_id 欄位讀取
# 若自動讀取失敗，才需要手動填入
GOOGLE_CLOUD_PROJECT=your-project-id

# ------------------------------------------------------------
# Gemini API 金鑰
# ------------------------------------------------------------
# 可從 https://aistudio.google.com/app/apikey 取得
# 程式也支援從 utils/api_keys.json 讀取（見下方說明）
GEMINI_API_KEY=your-gemini-api-key

# ============================================================
# 替代方案：utils/api_keys.json（目前專案使用的方式）
# ============================================================
# 若不使用 .env，也可在 utils/api_keys.json 填入以下內容：
# （*.json 已加入 .gitignore，不會被 commit）
#
# {
#   "GEMINI_API_KEY": "your-gemini-api-key",
#   "GOOGLE_APPLICATION_CREDENTIALS": "./utils/google-speech-key.json"
# }
#
# Gemini 金鑰載入優先順序：
#   1. 直接傳入程式參數
#   2. 環境變數 GEMINI_API_KEY
#   3. utils/api_keys.json
#   4. utils/api_keys.py

# =============================================================================
# SenseVoice 啟動暖機
# =============================================================================
# 伺服器啟動時在背景預載 SenseVoice 模型（~900MB），首次辨識零等待。
# 1/0 明確開關；未設定時自動判斷：STREAM_MODE=sensevoice_local 或
# STT_BACKEND=sensevoice 則開啟（離線 SenseVoice 為主的部署正好命中）。
# SENSEVOICE_WARMUP=1
