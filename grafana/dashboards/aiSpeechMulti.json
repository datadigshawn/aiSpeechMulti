        "type": "frser-sqlite-datasource",
        "uid": "aiSpeechMulti-sqlite"
      },
      "targets": [
        {
          "refId": "A",
          "rawQueryText": "WITH last_ts AS (   SELECT engine_label, MAX(timestamp_unix) AS ts   FROM cer_history GROUP BY engine_label ) SELECT h.engine_label AS '引擎',        MIN(h.avg_cer_final) AS '最佳 CER (final)',        h.timestamp_iso AS '時間' FROM cer_history h JOIN last_ts l ON h.engine_label = l.engine_label AND h.timestamp_unix = l.ts GROUP BY h.engine_label ORDER BY MIN(h.avg_cer_final) ASC",
          "queryType": "table",
          "timeColumns": []
        }
