          "rawQueryText": "SELECT timestamp_unix AS time, engine_label || ' (' || post_process || ')' AS metric, avg_cer_final AS value FROM cer_history WHERE post_process IN ('car_norm+dict+llm', 'car_norm+dict', 'raw') ORDER BY timestamp_unix",
