          "refId": "A",
          "rawQueryText": "WITH last_ts AS (   SELECT engine_label, event_type, MAX(timestamp_unix) AS ts   FROM cer_event_type_history GROUP BY engine_label, event_type ) SELECT e.engine_label AS '引擎', e.event_type AS '事件類型',        e.sample_count AS '樣本數',        e.avg_cer_raw AS 'raw CER',        e.avg_cer_final AS 'final CER',        e.avg_improvement AS '改善 pp' FROM cer_event_type_history e JOIN last_ts l ON e.engine_label = l.engine_label                 AND e.event_type = l.event_type                 AND e.timestamp_unix = l.ts ORDER BY e.engine_label, e.avg_cer_final DESC",
